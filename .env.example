# Coolify supplies this when source commits are available during the build.
# For a Git-derived local version, use the full 40-character Git commit SHA.
SOURCE_COMMIT=Version cannot be determined outside a Coolify deployment

# Public application identity
EOLAB_APP_TITLE=EOLab
EOLAB_APP_SUBTITLE=Explore, visualize, and analyze Earth observation data

# Required database secret; set this before the first deployment.
EOLAB_DATABASE_PASSWORD=

# Docker volume name; use a unique value for each deployment.
EOLAB_DATABASE_VOLUME_NAME=eolab-pgstac-data

# Administrator password: at least 16 letters, numbers, hyphens, underscores,
# or periods. The different master password must be at least eight characters.
EOLAB_GEOSERVER_ADMIN_PASSWORD=
EOLAB_GEOSERVER_MASTER_PASSWORD=
EOLAB_GEOSERVER_DATA_VOLUME_NAME=eolab-geoserver-data
EOLAB_PROCESSING_DATA_VOLUME_NAME=eolab-processing-data
EOLAB_GEOSERVER_CPU_LIMIT=4
EOLAB_GEOSERVER_MAX_HEAP_SIZE=4g
EOLAB_GEOSERVER_WMS_RENDER_COUNT=2
EOLAB_GEOSERVER_GWC_REQUEST_COUNT=8
EOLAB_GEOSERVER_WMS_QUEUE_TIMEOUT_SECONDS=10
EOLAB_GEOWEBCACHE_DISK_QUOTA_GIB=25

# In-process rendering and Rasterio capacity and cache limits.
EOLAB_COMPOSITE_TILE_CACHE_BYTES=134217728
EOLAB_RASTER_PIXEL_READ_CONCURRENCY=2
EOLAB_RASTER_STATISTICS_READ_CONCURRENCY=1
EOLAB_RASTER_STATISTICS_CACHE_ENTRIES=32

# Required host mount, relative scan paths, and user-facing path prefix.
EOLAB_SCAN_MOUNT_PATH=
EOLAB_SCAN_PATHS_WITHIN_MOUNT=["."]
EOLAB_SCAN_DISPLAY_PATH_PREFIX=bigboi -- Z:\bigbucket
EOLAB_SCAN_WORKER_COUNT=8
EOLAB_SCAN_WRITER_COUNT=4
EOLAB_SCAN_BATCH_SIZE=100
EOLAB_SCAN_ERROR_DETAIL_LIMIT=100
EOLAB_SCAN_RECONCILIATION_PAGE_SIZE=500
EOLAB_SCAN_RECONCILIATION_CONCURRENCY=8
EOLAB_SCAN_RECONCILIATION_SPOOL_MEMORY_BYTES=1048576
EOLAB_SCAN_CATALOG_WRITE_TIMEOUT_SECONDS=120
EOLAB_SCAN_CATALOG_ERROR_DETAIL_LIMIT=500

# Browser-facing STAC API path. Keep /stac for the Compose deployment.
EOLAB_CATALOG_URL=/stac

# Host port used only with docker-compose.local.yml.
EOLAB_HOST_PORT=8000
EOLAB_GEOSERVER_HOST_PORT=8081

# Public map configuration
EOLAB_BASEMAP_URL=https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png
EOLAB_BASEMAP_ATTRIBUTION=Map data: &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>, SRTM | Map style: &copy; <a href="https://opentopomap.org">OpenTopoMap</a> (<a href="https://creativecommons.org/licenses/by-sa/3.0/">CC-BY-SA</a>)
EOLAB_INITIAL_LATITUDE=20
EOLAB_INITIAL_LONGITUDE=0
EOLAB_INITIAL_ZOOM=2
# One private token shared by the app and Job service; required at startup.
# Generate 32–256 URL-safe characters. See docs/job-service.md.
# Never commit real credentials.
EOLAB_JOBS_TOKEN=
EOLAB_JOBS_QUEUE_CAPACITY=32
EOLAB_JOBS_RECORD_CAPACITY=128
EOLAB_JOBS_RETENTION_SECONDS=3600
EOLAB_JOBS_EXECUTION_TIMEOUT_SECONDS=60
EOLAB_JOBS_QUEUE_TIMEOUT_SECONDS=60
EOLAB_JOBS_MAX_TIMEOUT_SECONDS=300
